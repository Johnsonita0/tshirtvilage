{
  "buildCommand": "cd TshirtVilage && npm run build",
  "outputDirectory": "TshirtVilage/dist",
  "installCommand": "cd TshirtVilage && npm install",
  "rewrites": [
    {
      "source": "/(?!.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$)(.*)",
      "destination": "/index.html"
    }
  ]
}




